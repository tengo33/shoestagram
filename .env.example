FORECAST_API_KEY=
# On Railway Free/Hobby, set these to use Brevo's HTTPS API instead of SMTP.
# Verify the sender address in Brevo. Keep the API key in Railway Variables.
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=Shoestagram
# Localhost can continue using Gmail SMTP when BREVO_API_KEY is empty.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=shoestagram00@gmail.com
SMTP_PASSWORD=
SMTP_FROM_EMAIL=shoestagram00@gmail.com
SMTP_FROM_NAME=Shoestagram
SMTP_VERIFY_PEER=true
SHOESTAGRAM_ADMIN_EMAIL=shoestagram00@gmail.com
SHOESTAGRAM_STAFF_EMAIL=shoestagramstaff@gmail.com
